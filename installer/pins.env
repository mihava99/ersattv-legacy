# Versions bundled into the install packages.
# ffmpeg: the latest stable ErsatzTV-ffmpeg release (not the develop build pinned on main).
# FFMPEG_SHA256SUMS is the sha256 of that release's SHA256SUMS file.
# Next: this code sends channel config schema 0.1.3, which only the develop builds of Next understand
# (no stable Next release does yet). Same as .github/next-tag.
FFMPEG_REPO=ErsatzTV/ErsatzTV-ffmpeg
FFMPEG_TAG=8.1.2-6
FFMPEG_SHA256SUMS=a3169458af9d397db3ceab977d1772db4870567f6fa81a892a3e982bc5e70864
NEXT_REPO=ErsatzTV/next-develop-builds
NEXT_TAG=v0.2.4-2df934fc-develop
